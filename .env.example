# Neon Postgres connection string (server-only — never use NEXT_PUBLIC_ prefix)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Resend — emails each new enquiry (server-only)
RESEND_API_KEY=re_xxxxxxxx
# Must use a domain verified in Resend
CONTACT_EMAIL_FROM="Hurworth Handyman Website <enquiries@hurworthhandyman.com>"
# Optional — defaults to ben@hurworthhandyman.com
CONTACT_EMAIL_TO=ben@hurworthhandyman.com
